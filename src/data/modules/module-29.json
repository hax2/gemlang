  "vocabulary": {
    "vuelo": {
      "mnemonic": "Think 'vuela!' — a flight.",
      "explanation": "From 'volar' (to fly)."
    },
    "antes": {
      "mnemonic": "Think 'ante' (before in poker).",
      "explanation": "Means 'before'."
    },
    "puerta": {
      "mnemonic": "Think 'port/portal' — a door.",
      "explanation": "Feminine noun meaning door/gate."
    },
    "asiento": {
      "mnemonic": "'I sit-ento' — a seat.",
      "explanation": "Means 'seat'."
    },
    "tiempo": {
      "mnemonic": "Think 'tempo' — time and rhythm.",
      "explanation": "Means 'time' or 'weather'."
    },
    "pasaporte": {
      "mnemonic": "'Pass-a-port' — passport!",
      "explanation": "Nearly identical cognate."
    },
    "equipaje": {
      "mnemonic": "'Equip-aje' — your equipment/luggage.",
      "explanation": "Means 'luggage'."
    },
    "avión": {
      "mnemonic": "Think 'aviation' — airplane.",
      "explanation": "From 'ave' (bird)."
    },
    "aeropuerto": {
      "mnemonic": "'Aero + puerto' = air + port = airport!",
      "explanation": "Compound word."
    }
  },
