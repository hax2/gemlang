  "vocabulary": {
    "mesa": {
      "mnemonic": "A 'mesa' (flat-topped hill) — flat like a table.",
      "explanation": "Means 'table'. Feminine noun."
    },
    "noche": {
      "mnemonic": "Think 'nocturnal' — night.",
      "explanation": "Feminine noun."
    },
    "podría": {
      "mnemonic": "'Pod of possibility' — I could.",
      "explanation": "Conditional of 'poder'."
    },
    "plato": {
      "mnemonic": "'Plate-o' — a plate/dish.",
      "explanation": "Means 'plate/dish/course'."
    },
    "postre": {
      "mnemonic": "'Post-re' = after meal = dessert.",
      "explanation": "From Latin 'post' (after)."
    },
    "lleva": {
      "mnemonic": "'Lever-a' — he/she has been...",
      "explanation": "Third person of 'llevar'."
    },
    "cuenta": {
      "mnemonic": "Think 'count' — bill/account.",
      "explanation": "From 'contar' (to count)."
    },
    "encanta": {
      "mnemonic": "Think 'enchant' — it enchants me!",
      "explanation": "'Me encanta' = I love it."
    },
    "cocinar": {
      "mnemonic": "Think 'cuisine' — to cook!",
      "explanation": "Infinitive: 'to cook'."
    },
    "comprar": {
      "mnemonic": "'Compare & purchase' — to buy.",
      "explanation": "Infinitive. -AR verb."
    }
